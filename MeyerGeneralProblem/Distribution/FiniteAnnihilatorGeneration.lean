module

public import MeyerGeneralProblem.Cardinal.Strong.OriginalPairNumerator
public import Mathlib.GroupTheory.Finiteness

@[expose] public section

/-!
# Finite spectral generation from an actual finite annihilator

The recurrence preserves the subgroup generated by the shifts. Adding
the original occupied coefficients in the numerator window then
captures the entire two-sided array by the proved numerator uniqueness.
-/

namespace MeyerGeneralProblem

noncomputable section

open Set

/-- The support of an annihilated, locally finite two-sided array is contained
in the subgroup generated by the finite shifts and finitely many original
coefficients in one bounded frequency window. -/
theorem support_subset_finitely_generated_of_annihilatorArray
    {G : Type*} [AddCommGroup G] (L : G →+ ℝ) (hL : Function.Injective L)
    (p : G →₀ ℂ) (hp : p ≠ 0) (u : G → ℂ) (hu : FrequencyLocallyFinite L u)
    (hconv : ∀ n, annihilatorArrayConvolution p u n = 0) :
    ∃ E : Finset G, Function.support u ⊆ AddSubgroup.closure ((p.support : Set G) ∪ (E : Set G)) ∧
      (E : Set G) ⊆ Function.support u := by
  classical
  obtain ⟨m₀, m₁, hm₀, hm₁, hb, hmin, hmax⟩ := finiteAnnihilator_extrema L hL p hp
  let lo := L m₀
  let hi := L m₁
  let E : Set G := {n | u n ≠ 0 ∧ L n ∈ Icc 0 (hi - lo)}
  have hE : E.Finite := hu 0 (hi - lo)
  let H := AddSubgroup.closure ((p.support : Set G) ∪ (hE.toFinset : Set G))
  let v (n : G) := if n ∈ H then u n else 0
  have hpH {m : G} (hm : m ∈ p.support) : m ∈ H :=
    AddSubgroup.subset_closure (Or.inl hm)
  have hv : FrequencyLocallyFinite L v := by
    intro a b
    apply (hu a b).subset
    rintro n ⟨hn, hloc⟩
    exact ⟨fun h => hn (by simp [v, h]), hloc⟩
  have hvc (n : G) : annihilatorArrayConvolution p v n = 0 := by
    unfold annihilatorArrayConvolution
    by_cases hn : n ∈ H
    · rw [← hconv n]
      apply Finset.sum_congr rfl
      intro m hm
      simp [v, H.sub_mem hn (hpH hm)]
    · apply Finset.sum_eq_zero
      intro m hm
      have hnm : n - m ∉ H := fun h => hn (by simpa using H.add_mem h (hpH hm))
      simp [v, hnm]
  have hnum : cutArrayNumerator L p 0 v = cutArrayNumerator L p 0 u := by
    funext n
    by_cases hn : n ∈ H
    · unfold cutArrayNumerator annihilatorArrayConvolution
      apply Finset.sum_congr rfl
      intro m hm
      simp [arrayPositiveCut, v, H.sub_mem hn (hpH hm)]
    · have hz : cutArrayNumerator L p 0 v n = 0 := by
        unfold cutArrayNumerator annihilatorArrayConvolution
        apply Finset.sum_eq_zero
        intro m hm
        have hnm : n - m ∉ H := fun h => hn (by simpa using H.add_mem h (hpH hm))
        simp [arrayPositiveCut, v, hnm]
      rw [hz]
      by_contra hne
      have hnu := Ne.symm hne
      have hbound := cutArrayNumerator_support_slab L p 0 lo hi
        (fun _ hm => (hb _ hm).1) (fun _ hm => (hb _ hm).2) u hconv hnu
      obtain ⟨m, hm, hterm⟩ := Finset.exists_ne_zero_of_sum_ne_zero hnu
      have hcut : arrayPositiveCut L 0 u (n - m) ≠ 0 := (mul_ne_zero_iff.mp hterm).2
      have hpos : 0 ≤ L (n - m) := by
        by_contra hfalse
        exact hcut (by simp only [arrayPositiveCut, ite_eq_right hfalse])
      have hun : u (n - m) ≠ 0 := by simpa only [arrayPositiveCut, ite_eq_left hpos] using hcut
      have hmem : n - m ∈ E := by
        refine ⟨hun, hpos, ?_⟩
        rw [map_sub]
        linarith [(hb m hm).1, hbound.2]
      have hH : n - m ∈ H :=
        AddSubgroup.subset_closure (Or.inr (hE.mem_toFinset.mpr hmem))
      exact hn (by simpa using H.add_mem hH (hpH hm))
  have heq := cutArrayNumerator_injective_on_kernel L p m₀ m₁ hm₀ hm₁
    hmin hmax 0 v u hv hu hvc hconv hnum
  refine ⟨hE.toFinset, ?_, fun n hn => (hE.mem_toFinset.mp hn).1⟩
  intro n hn
  by_contra hnot
  have hvn : v n = 0 := by simp [v, show n ∉ H from hnot]
  exact hn ((congrFun heq n).symm.trans hvn)

open scoped FourierTransform

/-- When the spectral carrier consists of actual atoms, an annihilator
with frequencies in the original spectral module proves finite generation
of that exact module. -/
theorem spectralModule_fg_of_finiteExponentialAnnihilator
    {ι : Type*} [Fintype ι] (B : LocallyFiniteCarrier) (U : TemperedDistribution ℝ ℂ)
    (hB : AtomicOnCarrier B (𝓕 U))
    (hactual : ∀ x : B.subtype, (𝓕 U) (B.isolationSchwartz x) ≠ 0)
    (a : ι → ℝ) (c : ι → ℂ) (ha : Function.Injective a) (hc : c ≠ 0)
    (hfreq : ∀ i, a i ∈ AddSubgroup.closure B.carrier)
    (hzero : finiteExponentialMultiplication a c U = 0) :
    (AddSubgroup.closure B.carrier).FG := by
  classical
  let H := AddSubgroup.closure B.carrier
  let e : ι ↪ H := ⟨fun i => ⟨a i, hfreq i⟩, fun i j he => ha (congrArg Subtype.val he)⟩
  let p₀ : ι →₀ ℂ := Finsupp.equivFunOnFinite.symm c
  let p := p₀.embDomain e
  have hp₀ : p₀ ≠ 0 := by
    intro hp
    apply hc
    simpa [p₀] using congrArg (fun u : ι →₀ ℂ => (u : ι → ℂ)) hp
  have hp : p ≠ 0 := Finsupp.embDomain_eq_zero.not.mpr hp₀
  let u := originalFourierArray H.subtype B U
  have hconv : finiteCombConvolution a c (𝓕 U) = 0 := by
    rw [← fourier_finiteExponentialMultiplication, hzero, FourierTransform.fourier_zero]
  have hrec (w : H) : annihilatorArrayConvolution p u w = 0 := by
    have hrow := extendedAtomicCoefficient_finiteCombConvolution B (𝓕 U) hB a c (w : ℝ)
    rw [hconv] at hrow
    have hcoeff0 : extendedAtomicCoefficient (finiteCombConvolutionCarrier B a) 0 (w : ℝ) = 0 := by
      unfold extendedAtomicCoefficient
      split_ifs <;> simp
    rw [hcoeff0] at hrow
    unfold annihilatorArrayConvolution p
    rw [Finsupp.support_embDomain, Finset.sum_map]
    simp only [Finsupp.embDomain_apply_self]
    change (∑ i ∈ p₀.support, c i * extendedAtomicCoefficient B (𝓕 U) ((w : ℝ) - a i)) = 0
    calc
      _ = ∑ i, c i * extendedAtomicCoefficient B (𝓕 U) ((w : ℝ) - a i) := by
        apply Finset.sum_subset (Finset.subset_univ _)
        intro i _ hi
        have hci : c i = 0 := Finsupp.notMem_support_iff.mp hi
        rw [hci, zero_mul]
      _ = 0 := hrow.symm
  obtain ⟨E, hE, _⟩ := support_subset_finitely_generated_of_annihilatorArray H.subtype
    Subtype.val_injective p hp u (originalFourierArray_frequencyLocallyFinite _ Subtype.val_injective B U) hrec
  let F := (p.support : Set H) ∪ (E : Set H)
  apply (AddSubgroup.fg_iff H).2
  refine ⟨H.subtype '' F, ?_, ((p.support.finite_toSet).union E.finite_toSet).image _⟩
  apply le_antisymm
  · apply (AddSubgroup.closure_le _).2
    rintro _ ⟨n, _, rfl⟩
    exact n.property
  · apply (AddSubgroup.closure_le _).2
    intro x hx
    let n : H := ⟨x, AddSubgroup.subset_closure hx⟩
    have hn : n ∈ Function.support u := by
      change extendedAtomicCoefficient B (𝓕 U) x ≠ 0
      simpa only [extendedAtomicCoefficient, dite_eq_left hx] using hactual ⟨x, hx⟩
    rw [← AddMonoidHom.map_closure]
    exact ⟨n, hE hn, rfl⟩

end

end MeyerGeneralProblem
