module

public import MeyerGeneralProblem.Cardinal.Strong.OriginalPairNumerator
public import Mathlib.GroupTheory.QuotientGroup.Basic

@[expose] public section

/-!
# Exact coset splitting of the original Laurent recurrence

The differences of denominator labels preserve each source coset.
The literal cut is split by the same cosets, shifted by the chosen
denominator label. Extremal uniqueness detects every active coset in
the finite cut numerator.
-/

namespace MeyerGeneralProblem

noncomputable section

open Set

variable {G : Type*} [AddCommGroup G]

/-- The subgroup generated by differences from a fixed denominator label. -/
def laurentSupportDifferenceSubgroup (p : G →₀ ℂ) (m₀ : G) : AddSubgroup G :=
  AddSubgroup.closure ((fun m => m - m₀) '' (p.support : Set G))

/-- The original array restricted to exactly one additive coset. -/
def laurentCosetArray (H : AddSubgroup G) (q : G ⧸ H) (u : G → ℂ) (n : G) : ℂ := by
  classical
  exact if QuotientAddGroup.mk' H n = q then u n else 0

private theorem laurentCosetArray_frequencyLocallyFinite (L : G →+ ℝ)
    (H : AddSubgroup G) (q : G ⧸ H) (u : G → ℂ)
    (hu : FrequencyLocallyFinite L u) :
    FrequencyLocallyFinite L (laurentCosetArray H q u) := by
  intro a b
  apply (hu a b).subset
  intro n hn
  refine ⟨fun h => hn.1 ?_, hn.2⟩
  unfold laurentCosetArray
  split <;> simp [h]

private theorem laurentSupportDifferenceSubgroup_shift (p : G →₀ ℂ) (m₀ : G)
    (m : G) (hm : m ∈ p.support) (n : G) :
    QuotientAddGroup.mk' (laurentSupportDifferenceSubgroup p m₀) (n - m) =
      QuotientAddGroup.mk' (laurentSupportDifferenceSubgroup p m₀) (n - m₀) := by
  apply QuotientAddGroup.eq_iff_sub_mem.mpr
  rw [show n - m - (n - m₀) = -(m - m₀) by abel]
  exact (laurentSupportDifferenceSubgroup p m₀).neg_mem
    (AddSubgroup.subset_closure ⟨m, hm, rfl⟩)

/-- Every original coefficient in one output convolution uses the
same source coset, shifted back by the reference denominator label. -/
theorem annihilatorArrayConvolution_laurentCosetArray
    (p : G →₀ ℂ) (m₀ : G) (u : G → ℂ) (n : G)
    (q : G ⧸ laurentSupportDifferenceSubgroup p m₀) :
    annihilatorArrayConvolution p (laurentCosetArray (laurentSupportDifferenceSubgroup p m₀) q u) n =
      laurentCosetArray (laurentSupportDifferenceSubgroup p m₀) q
        (fun k => annihilatorArrayConvolution p u (k + m₀)) (n - m₀) := by
  classical
  unfold annihilatorArrayConvolution laurentCosetArray
  simp only [sub_add_cancel]
  split_ifs with h
  · apply Finset.sum_congr rfl
    intro m hm
    rw [ite_eq_left ((laurentSupportDifferenceSubgroup_shift p m₀ m hm n).trans h)]
  · apply Finset.sum_eq_zero
    intro m hm
    rw [ite_eq_right (fun he => h ((laurentSupportDifferenceSubgroup_shift p m₀ m hm n).symm.trans he)), mul_zero]

/-- Splitting the original array into cosets commutes with taking its
literal cut numerator, with the same output translation. -/
theorem cutArrayNumerator_laurentCosetArray
    (L : G →+ ℝ) (p : G →₀ ℂ) (m₀ : G) (s : ℝ) (u : G → ℂ)
    (q : G ⧸ laurentSupportDifferenceSubgroup p m₀) (n : G) :
    cutArrayNumerator L p s (laurentCosetArray (laurentSupportDifferenceSubgroup p m₀) q u) n =
      laurentCosetArray (laurentSupportDifferenceSubgroup p m₀) q
        (fun k => cutArrayNumerator L p s u (k + m₀)) (n - m₀) := by
  have hs : arrayPositiveCut L s (laurentCosetArray (laurentSupportDifferenceSubgroup p m₀) q u) =
      laurentCosetArray (laurentSupportDifferenceSubgroup p m₀) q (arrayPositiveCut L s u) := by
    funext k
    unfold arrayPositiveCut laurentCosetArray
    split <;> split <;> simp_all
  unfold cutArrayNumerator
  rw [hs, annihilatorArrayConvolution_laurentCosetArray]

/-- The image of the finite literal numerator support is exactly the
set of active source cosets. No inactive or incompatible spectral label
is used to infer the active cosets. -/
theorem activeLaurentCosets_eq_cutNumerator_image
    (L : G →+ ℝ) (hL : Function.Injective L) (p : G →₀ ℂ) (hp : p ≠ 0)
    (m₀ : G) (s : ℝ) (u : G → ℂ) (hu : FrequencyLocallyFinite L u)
    (hrec : ∀ n, annihilatorArrayConvolution p u n = 0) :
    let H := laurentSupportDifferenceSubgroup p m₀
    let χ := QuotientAddGroup.mk' H
    {q : G ⧸ H | ∃ n, χ n = q ∧ u n ≠ 0} =
      (fun n => χ (n - m₀)) '' Function.support (cutArrayNumerator L p s u) := by
  classical
  let H := laurentSupportDifferenceSubgroup p m₀
  let χ := QuotientAddGroup.mk' H
  obtain ⟨lo, hi, hlo, hhi, _, hmin, hmax⟩ := finiteAnnihilator_extrema L hL p hp
  ext q
  let v := laurentCosetArray H q u
  have hv : FrequencyLocallyFinite L v := laurentCosetArray_frequencyLocallyFinite L H q u hu
  have hvrec (n : G) : annihilatorArrayConvolution p v n = 0 := by
    rw [annihilatorArrayConvolution_laurentCosetArray p m₀ u n q]
    simp [laurentCosetArray, hrec]
  have hcut (n : G) : cutArrayNumerator L p s v n =
      if χ (n - m₀) = q then cutArrayNumerator L p s u n else 0 := by
    rw [cutArrayNumerator_laurentCosetArray L p m₀ s u q n]
    unfold laurentCosetArray
    simp only [sub_add_cancel]
    rfl
  have hcut_vanishes_of_inactive (hn : ¬∃ n, χ n = q ∧ u n ≠ 0) :
      v = 0 := by
    funext k
    by_cases hk : χ k = q
    · have hku : u k = 0 := not_not.mp fun h => hn ⟨k, hk, h⟩
      change laurentCosetArray H q u k = 0
      unfold laurentCosetArray
      rw [ite_eq_left hk, hku]
    · change laurentCosetArray H q u k = 0
      unfold laurentCosetArray
      rw [ite_eq_right hk]
  have hzeroCut : cutArrayNumerator L p s (0 : G → ℂ) = 0 := by
    funext n
    by_cases hn : s ≤ L n
    all_goals simp [cutArrayNumerator, annihilatorArrayConvolution, arrayPositiveCut]
  constructor
  · rintro ⟨k, hk, hku⟩
    by_contra hmiss
    have hvcut : cutArrayNumerator L p s v = cutArrayNumerator L p s 0 := by
      rw [hzeroCut]
      funext n
      rw [hcut n]
      split_ifs with hn
      · by_contra hne
        exact hmiss ⟨n, hne, hn⟩
      · rfl
    have hzero : FrequencyLocallyFinite L (0 : G → ℂ) := by simp [FrequencyLocallyFinite]
    have hvzero : v = 0 := cutArrayNumerator_injective_on_kernel L p lo hi hlo hhi
      hmin hmax s v 0 hv hzero hvrec (fun n => by simp [annihilatorArrayConvolution]) hvcut
    apply hku
    have hh : laurentCosetArray H q u k = 0 := congrFun hvzero k
    unfold laurentCosetArray at hh
    rwa [ite_eq_left hk] at hh
  · rintro ⟨n, hn, hnq⟩
    by_contra hinactive
    have hvzero := hcut_vanishes_of_inactive hinactive
    have h := hcut n
    rw [ite_eq_left hnq, hvzero, hzeroCut] at h
    exact hn h.symm

/-- Every active coset is witnessed by a label in the actual finite cut
numerator, so only finitely many cosets can contribute to physical rows. -/
theorem finite_activeLaurentCosets
    (L : G →+ ℝ) (hL : Function.Injective L) (p : G →₀ ℂ) (hp : p ≠ 0)
    (m₀ : G) (s : ℝ) (u : G → ℂ) (hu : FrequencyLocallyFinite L u)
    (hrec : ∀ n, annihilatorArrayConvolution p u n = 0) :
    let H := laurentSupportDifferenceSubgroup p m₀
    {q : G ⧸ H | ∃ n, QuotientAddGroup.mk' H n = q ∧ u n ≠ 0}.Finite := by
  dsimp only
  rw [activeLaurentCosets_eq_cutNumerator_image L hL p hp m₀ s u hu hrec]
  obtain ⟨lo, hi, _, _, hbounds, _, _⟩ := finiteAnnihilator_extrema L hL p hp
  exact (cutArrayNumerator_support_finite L p s (L lo) (L hi)
    (fun m hm => (hbounds m hm).1) (fun m hm => (hbounds m hm).2) u hu hrec).image _

end

end MeyerGeneralProblem
