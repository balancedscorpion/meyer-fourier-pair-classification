module

public import Mathlib.NumberTheory.Padics.RingHoms
public import Mathlib.RingTheory.AlgebraicIndependent.Transcendental
public import Mathlib.Algebra.AlgebraicCard
public import Mathlib.Algebra.FreeAlgebra.Cardinality
public import Mathlib.Logic.Equiv.Fin.Basic
public import Mathlib.Tactic.NormNum
public import Mathlib.Tactic.Ring

@[expose] public section

/-!
# Algebraically independent p-adic lifts in prescribed residue classes

Distinct binary digit sequences give distinct p-adic integers. In any
fixed residue class, one can then avoid the countable algebraic locus
over the field generated by the preceding finite tuple.
-/

namespace MeyerGeneralProblem

noncomputable section

open Set
open scoped BigOperators

section Padic

variable (p : ℕ) [hp : Fact p.Prime]

private def binaryDigit (b : Bool) : ℤ :=
  if b then 1 else 0

private def binaryPadicPartialSum (b : ℕ → Bool) (n : ℕ) : ℤ :=
  ∑ i ∈ Finset.range n, binaryDigit (b i) * (p : ℤ) ^ i

omit [Fact p.Prime] in
private theorem binaryPadicPartialSum_step (b : ℕ → Bool) (n : ℕ) :
    (p : ℤ) ^ n ∣ binaryPadicPartialSum p b (n + 1) - binaryPadicPartialSum p b n := by
  unfold binaryPadicPartialSum
  rw [Finset.sum_range_succ, add_sub_cancel_left]
  exact ⟨binaryDigit (b n), mul_comm _ _⟩

private def binaryPadicInteger (b : ℕ → Bool) : ℤ_[p] :=
  PadicInt.ofIntSeq _ <| PadicInt.isCauSeq_padicNorm_of_pow_dvd_sub
    (binaryPadicPartialSum p b) p (binaryPadicPartialSum_step p b)

private theorem binaryPadicInteger_toZModPow (b : ℕ → Bool) (n : ℕ) :
    (binaryPadicInteger p b).toZModPow n = (binaryPadicPartialSum p b n : ZMod (p ^ n)) :=
  PadicInt.toZModPow_ofIntSeq_of_pow_dvd_sub (binaryPadicPartialSum p b) p
    (binaryPadicPartialSum_step p b) n

private theorem binaryPadicInteger_injective : Function.Injective (binaryPadicInteger p) := by
  intro b c hbc
  funext n
  induction n using Nat.strong_induction_on with
  | h n ih =>
      let _ : NeZero (p ^ (n + 1)) := ⟨pow_ne_zero _ hp.out.ne_zero⟩
      have he := congrArg (fun x : ℤ_[p] => x.toZModPow (n + 1)) hbc
      simp only [binaryPadicInteger_toZModPow] at he
      have hdiv : (p : ℤ) ^ (n + 1) ∣
          binaryPadicPartialSum p b (n + 1) - binaryPadicPartialSum p c (n + 1) := by
        exact_mod_cast (ZMod.intCast_eq_intCast_iff_dvd_sub _ _ _).mp he.symm
      have hprefix : binaryPadicPartialSum p b n = binaryPadicPartialSum p c n := by
        unfold binaryPadicPartialSum
        exact Finset.sum_congr rfl (fun i hi => by rw [ih i (Finset.mem_range.mp hi)])
      unfold binaryPadicPartialSum at hdiv
      rw [Finset.sum_range_succ, Finset.sum_range_succ] at hdiv
      change (p : ℤ) ^ (n + 1) ∣
        binaryPadicPartialSum p b n + binaryDigit (b n) * (p : ℤ) ^ n -
          (binaryPadicPartialSum p c n + binaryDigit (c n) * (p : ℤ) ^ n) at hdiv
      rw [hprefix, add_sub_add_left_eq_sub, ← sub_mul] at hdiv
      have hcancel : (p : ℤ) ∣ binaryDigit (b n) - binaryDigit (c n) := by
        rw [pow_succ'] at hdiv
        exact Int.dvd_of_mul_dvd_mul_right (pow_ne_zero _ (by exact_mod_cast hp.out.ne_zero)) hdiv
      cases hb : b n <;> cases hc : c n <;> simp [hb, hc, binaryDigit] at hcancel ⊢
      all_goals exact hp.out.ne_one (Nat.dvd_one.mp (by exact_mod_cast hcancel))

private theorem boolStreams_uncountable : Uncountable (ℕ → Bool) := by
  apply uncountable_iff_forall_not_surjective.mpr
  intro f hf
  obtain ⟨n, hn⟩ := hf (fun j => !(f j j))
  have h := congrFun hn n
  cases hf' : f n n <;> simp [hf'] at h

/-- The p-adic integers are already uncountable via binary digit streams. -/
theorem padicInt_uncountable : Uncountable ℤ_[p] := by
  let _ := boolStreams_uncountable
  exact (binaryPadicInteger_injective p).uncountable

/-- Every integral residue class contains an element transcendental over
each countable rational subalgebra of the ambient p-adic field. -/
theorem exists_transcendental_padicInt_lift (A : Subalgebra ℚ ℚ_[p]) [Countable A] (r : ℤ) :
    ∃ x : ℤ_[p], PadicInt.toZMod x = (r : ZMod p) ∧
      Transcendental A (x : ℚ_[p]) := by
  classical
  let _ := padicInt_uncountable p
  let g (u : ℤ_[p]) : ℤ_[p] := (r : ℤ_[p]) + (p : ℤ_[p]) * u
  have hg : Function.Injective g := by
    intro x y h
    have he : (p : ℤ_[p]) * x = (p : ℤ_[p]) * y := add_left_cancel h
    exact mul_left_cancel₀ (Nat.cast_ne_zero.mpr hp.out.ne_zero) he
  have hres (u : ℤ_[p]) : PadicInt.toZMod (g u) = (r : ZMod p) := by
    simp [g, map_add, map_mul]
  by_contra! h
  have hAlg := Algebraic.countable A ℚ_[p]
  let f (u : ℤ_[p]) : {x : ℚ_[p] | IsAlgebraic A x} :=
    ⟨(g u : ℚ_[p]), not_not.mp (h (g u) (hres u))⟩
  let _ : Countable {x : ℚ_[p] | IsAlgebraic A x} := hAlg
  have hf : Function.Injective f := by
    intro x y hxy
    apply hg
    exact Subtype.ext (congrArg (fun y : {x : ℚ_[p] | IsAlgebraic A x} => y.val) hxy)
  exact not_countable hf.countable

/-- A prescribed finite tuple of residues has a jointly algebraically
independent tuple of p-adic integer lifts. -/
theorem exists_algebraicIndependent_padicInt_lifts :
    ∀ (n : ℕ) (r : Fin n → ℤ),
      ∃ x : Fin n → ℤ_[p], AlgebraicIndependent ℚ (fun i => (x i : ℚ_[p])) ∧
        ∀ i, PadicInt.toZMod (x i) = (r i : ZMod p) := by
  classical
  intro n
  induction n with
  | zero =>
      intro r
      exact ⟨Fin.elim0, algebraicIndependent_empty_type, fun i => Fin.elim0 i⟩
  | succ n ih =>
      intro r
      obtain ⟨x, hx, hrx⟩ := ih (fun i => r i.succ)
      let v (i : Fin n) := (x i : ℚ_[p])
      let A := Algebra.adjoin ℚ (range v)
      have hc : Countable A := by
        let _ : Countable (range v) := (Set.finite_range v).countable
        apply Cardinal.mk_le_aleph0_iff.mp
        exact (Algebra.cardinalMk_adjoin_le ℚ (range v)).trans (by simp)
      let _ := hc
      obtain ⟨q, hq, ht⟩ := exists_transcendental_padicInt_lift p A (r 0)
      let z : Fin (n + 1) → ℤ_[p] := Fin.cons q x
      refine ⟨z, ?_, ?_⟩
      · have hi := (hx.option_iff_transcendental (q : ℚ_[p])).mpr ht
        have h := hi.comp (finSuccEquiv n) (finSuccEquiv n).injective
        convert h using 1
        funext i
        refine Fin.cases ?_ (fun j => ?_) i
        · simp [z, finSuccEquiv_zero]
        · simp [z, finSuccEquiv_succ]
      · intro i
        refine Fin.cases ?_ (fun j => ?_) i
        · exact hq
        · exact hrx j

end Padic

end
end MeyerGeneralProblem
