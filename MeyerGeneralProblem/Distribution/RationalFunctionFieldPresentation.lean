module

public import Mathlib.Algebra.Algebra.Hom.Rat
public import Mathlib.Algebra.Algebra.Rat
public import Mathlib.FieldTheory.IntermediateField.Adjoin.Algebra
public import Mathlib.FieldTheory.PrimitiveElement
public import Mathlib.RingTheory.AlgebraicIndependent.AlgebraicClosure
public import Mathlib.RingTheory.AlgebraicIndependent.Basic
public import Mathlib.RingTheory.AlgebraicIndependent.TranscendenceBasis
public import Mathlib.RingTheory.IsAdjoinRoot
public import Mathlib.RingTheory.Localization.FractionRing

@[expose] public section

/-!
# Fraction-field and primitive-element presentations over the rationals

Evaluation at algebraically independent generators identifies their field
with the fraction field of the integer polynomial ring. A finitely generated
rational extension is simple and separable over such a field.
-/

namespace MeyerGeneralProblem

noncomputable section

open IntermediateField

section TranscendentalCoordinates

variable {L : Type*} [Field L] [CharZero L] [Algebra ℚ L]
variable {n : ℕ} (t : Fin n → L)

local notation "ZPoly[" n "]" => MvPolynomial (Fin n) ℤ
local notation "F[" t "]" => (IntermediateField.adjoin ℚ (Set.range t))

/-- Evaluation sends the integer polynomials into the field generated by
the given finite tuple. -/
def integralTranscendenceEvaluation : ZPoly[n] →+* F[t] :=
  MvPolynomial.eval₂Hom (Int.castRingHom F[t])
    (fun i => ⟨t i, IntermediateField.subset_adjoin ℚ _ (Set.mem_range_self i)⟩)

/-- Algebraically independent generators exhibit their intermediate field
as the fraction field of the integer polynomial ring. -/
theorem isFractionRing_of_algIndependent_adjoin (ht : AlgebraicIndependent ℚ t) :
    letI : Algebra ZPoly[n] F[t] := (integralTranscendenceEvaluation t).toAlgebra
    IsFractionRing ZPoly[n] F[t] := by
  let σ := integralTranscendenceEvaluation t
  let : Algebra ZPoly[n] F[t] := σ.toAlgebra
  let val := (IntermediateField.adjoin ℚ (Set.range t)).toSubfield.subtype
  let m := MvPolynomial.map (σ := Fin n) (Int.castRingHom ℚ)
  have hm : Function.Injective m := MvPolynomial.map_injective (Int.castRingHom ℚ) Int.cast_injective
  have hvar (i : Fin n) : val (σ (MvPolynomial.X i)) = t i := by
    change val (MvPolynomial.eval₂Hom (Int.castRingHom F[t])
      (fun j => ⟨t j, IntermediateField.subset_adjoin ℚ _ (Set.mem_range_self j)⟩)
      (MvPolynomial.X i)) = t i
    rw [MvPolynomial.eval₂Hom_X']
    rfl
  have he : val.comp σ = (MvPolynomial.aeval (R := ℚ) t).toRingHom.comp m := by
    apply MvPolynomial.ringHom_ext
    · intro a
      simp [val, σ, integralTranscendenceEvaluation, m]
    · intro i
      simpa only [RingHom.comp_apply, AlgHom.toRingHom_eq_coe, AlgHom.coe_toRingHom,
        m, MvPolynomial.map_X, MvPolynomial.aeval_X] using hvar i
  have hinj : Function.Injective σ := by
    have h : Function.Injective (val.comp σ) := by
      rw [he]
      exact (algebraicIndependent_iff_injective_aeval.mp ht).comp hm
    exact fun x y hxy => h (congrArg val hxy)
  let f : FractionRing ZPoly[n] →+* F[t] := IsFractionRing.lift hinj
  have hf (x : ZPoly[n]) :
      f (algebraMap ZPoly[n] (FractionRing ZPoly[n]) x) = σ x :=
    IsFractionRing.lift_algebraMap hinj x
  let : CharZero (FractionRing ZPoly[n]) := (val.comp f).charZero
  let g : FractionRing ZPoly[n] →ₐ[ℚ] L := (val.comp f).toRatAlgHom
  have hr : IntermediateField.adjoin ℚ (Set.range t) ≤ g.fieldRange := by
    apply IntermediateField.adjoin_le_iff.mpr
    rintro _ ⟨i, rfl⟩
    refine ⟨algebraMap ZPoly[n] (FractionRing ZPoly[n]) (MvPolynomial.X i), ?_⟩
    change val (f (algebraMap ZPoly[n] (FractionRing ZPoly[n]) (MvPolynomial.X i))) = t i
    rw [hf]
    exact hvar i
  have hsurj : Function.Surjective f := by
    intro x
    obtain ⟨y, hy⟩ := hr x.property
    exact ⟨y, Subtype.ext hy⟩
  let fA : FractionRing ZPoly[n] →ₐ[ZPoly[n]] F[t] := { f with commutes' := hf }
  exact IsFractionRing.of_algEquiv (AlgEquiv.ofBijective fA ⟨f.injective, hsurj⟩)

end TranscendentalCoordinates

open scoped IntermediateField

/-- A finitely generated characteristic-zero field has a finite
transcendence basis whose remaining extension is separable and simple. -/
theorem exists_primitivePresentation_over_fin_transcendenceBasis
    (L : Type*) [Field L] [CharZero L] [Algebra ℚ L] [Algebra.EssFiniteType ℚ L] :
    ∃ (n : ℕ) (t : Fin n → L), IsTranscendenceBasis ℚ t ∧
      ∃ f : Polynomial (IntermediateField.adjoin ℚ (Set.range t)),
        f.Monic ∧ 0 < f.natDegree ∧ IsCoprime f f.derivative ∧ Nonempty (IsAdjoinRoot L f) := by
  classical
  obtain ⟨s, hs⟩ := IntermediateField.fg_top ℚ L
  have : Algebra.IsAlgebraic (Algebra.adjoin ℚ (s : Set L)) L := by
    rw [← isAlgebraic_adjoin_iff_top, hs, Algebra.isAlgebraic_iff_isIntegral]
    apply Algebra.isIntegral_of_surjective
    intro x
    exact ⟨⟨x, IntermediateField.mem_top⟩, rfl⟩
  obtain ⟨u, hus, hu⟩ := exists_isTranscendenceBasis_subset (R := ℚ) (s : Set L)
  let _ := (s.finite_toSet.subset hus).fintype
  let e := Fintype.equivFin u
  let t : Fin (Fintype.card u) → L := Subtype.val ∘ e.symm
  have ht : IsTranscendenceBasis ℚ t := hu.comp_equiv e.symm
  let F := IntermediateField.adjoin ℚ (Set.range t)
  have : Algebra.IsAlgebraic F L := ht.isAlgebraic_field
  have : Algebra.EssFiniteType F L := .of_comp ℚ F L
  have : Module.Finite F L := Algebra.finite_of_essFiniteType_of_isAlgebraic
  let : CharZero F := F.toSubfield.subtype.charZero
  obtain ⟨α, hα⟩ := Field.exists_primitive_element F L
  have hsep := Algebra.IsSeparable.isSeparable F α
  have hIntegral := hsep.isIntegral
  exact ⟨_, t, ht, minpoly F α, minpoly.monic hIntegral, minpoly.natDegree_pos hIntegral,
    hsep, ⟨IsAdjoinRoot.mkOfPrimitiveElement hIntegral hα⟩⟩

end
end MeyerGeneralProblem
