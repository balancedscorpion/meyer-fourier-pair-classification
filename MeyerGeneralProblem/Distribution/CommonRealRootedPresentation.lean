module

public import MeyerGeneralProblem.Distribution.FiniteIntegerGrading
public import MeyerGeneralProblem.Distribution.OriginalLaurentRealRootedCore
public import MeyerGeneralProblem.Distribution.RationalRowDimension

@[expose] public section

/-!
# A real-rooted presentation in the exact spectral module

The full space has one finite polynomial in its original active spectral
module. Factoring that polynomial and cancelling its discarded part on
the two actual Fourier cuts produces a real-rooted denominator for the
whole space. The literal rows then give its exact dimension.
-/

namespace MeyerGeneralProblem

noncomputable section

open Set

/-- The additive subgroup generated by all active original Fourier sites
of the entire pair space on the two allowed carriers. -/
def pairSpectralModule (A B : LocallyFiniteCarrier) : AddSubgroup ℝ :=
  AddSubgroup.closure
    (atomicSupportUnion B ((DistributionalMeyerPairSpace A B).map temperedFourierLinearMap)).carrier

/-- Intersect the allowed Fourier carrier with the exact spectral module,
retaining the allowed padding inside that module. -/
def pairSpectralCore (A B : LocallyFiniteCarrier) : LocallyFiniteCarrier :=
  B.restrict (B.carrier ∩ (pairSpectralModule A B : Set ℝ)) inter_subset_left

private theorem pairSpectralCore_range (A B : LocallyFiniteCarrier) :
    (pairSpectralCore A B).carrier ⊆ range (pairSpectralModule A B).subtype := by
  intro x hx
  exact ⟨⟨x, hx.2⟩, rfl⟩

/-- Every bounded-count physical carrier and locally finite Fourier carrier
has a common real-rooted Laurent denominator in its exact original module.
Restricting physical points to its zeros and Fourier points to the module
preserves the complete pair space. -/
theorem exists_common_realRooted_core_of_unitCellBound
    (A B : LocallyFiniteCarrier) (K : ℕ) (hK : UnitCellBound A K) :
    let Γ := pairSpectralModule A B
    let L := Γ.subtype
    Γ.FG ∧
      ∃ p d g : AddMonoidAlgebra ℂ Γ, p ≠ 0 ∧ p = d * g ∧ g ≠ 0 ∧
        (∀ x ∈ (atomicSupportUnion A (DistributionalMeyerPairSpace A B)).carrier,
          annihilatorExponentialSymbol L p.coeff x = 0) ∧
        (∀ z : ℂ, z.im ≠ 0 → complexExponentialSum L g.coeff z ≠ 0) ∧
        DistributionalMeyerPairSpace A B =
          DistributionalMeyerPairSpace (annihilatorZeroSubcarrier L g.coeff A)
            (pairSpectralCore A B) := by
  classical
  let V := DistributionalMeyerPairSpace A B
  let C := atomicSupportUnion A V
  let B₀ := atomicSupportUnion B (V.map temperedFourierLinearMap)
  let Γ := pairSpectralModule A B
  let L := Γ.subtype
  let B' := pairSpectralCore A B
  have hL : Function.Injective L := Subtype.val_injective
  obtain ⟨hΓ, σ, fi, a, c, ha, hamem, hnonzero, hzero, _⟩ :=
    spectralModule_fg_and_exists_common_finiteExponentialAnnihilator_of_unitCellBound A B K hK
  let _ := fi
  let j : σ ↪ Γ := ⟨fun i => ⟨a i, hamem i⟩, fun _ _ h => ha (congrArg Subtype.val h)⟩
  let q : σ →₀ ℂ := Finsupp.equivFunOnFinite.symm c
  let p : AddMonoidAlgebra ℂ Γ := AddMonoidAlgebra.ofCoeff (q.embDomain j)
  have hsymbol (x : ℝ) :
      annihilatorExponentialSymbol L p.coeff x =
        ∑ i, c i * combModulationCharacter (a i) x := by
    change (q.embDomain j).sum (fun m r => r * combModulationCharacter (L m) x) = _
    rw [Finsupp.sum_embDomain]
    rw [Finsupp.sum_fintype _ _ (fun _ => zero_mul _)]
    apply Finset.sum_congr rfl
    intro i _
    rfl
  have hp : p ≠ 0 := by
    obtain ⟨x, hx⟩ := hnonzero
    intro hp
    apply hx
    rw [← hsymbol x, hp, AddMonoidAlgebra.coeff_zero]
    simp [annihilatorExponentialSymbol]
  have hC : C.carrier ⊆ A.carrier := fun _ ⟨hx, _⟩ => hx
  have hB' : B'.carrier ⊆ B.carrier := inter_subset_left
  have hB₀ : B₀.carrier ⊆ B'.carrier := by
    intro x hx
    have hxB : x ∈ B.carrier := by
      obtain ⟨hxB, _⟩ := hx
      exact hxB
    exact ⟨hxB, AddSubgroup.subset_closure hx⟩
  have hrestrict : V = DistributionalMeyerPairSpace C B' :=
    distributionalMeyerPairSpace_eq_of_contains_atomicSupportUnion A B C B'
      hC hB' Subset.rfl hB₀
  have hpC (x : ℝ) (hx : x ∈ C.carrier) : annihilatorExponentialSymbol L p.coeff x = 0 := by
    rw [hsymbol]
    exact hzero x hx
  let _ : Module.Finite ℤ Γ := Module.Finite.iff_addGroup_fg.mpr
    ((AddGroup.fg_iff_addSubgroup_fg Γ).mpr hΓ)
  obtain ⟨n, basis⟩ := Module.basisOfFiniteTypeTorsionFree' (R := ℤ) (M := Γ)
  obtain ⟨d, g, hpg, hg, hroot, hcore⟩ :=
    exists_realRooted_common_core_of_Laurent_annihilator basis L hL p hp C B'
      (pairSpectralCore_range A B) hpC
  refine ⟨hΓ, p, d, g, hp, hpg, hg, hpC, hroot, ?_⟩
  have heq := hrestrict.trans hcore
  have hCsub : (annihilatorZeroSubcarrier L g.coeff C).carrier ⊆
      (annihilatorZeroSubcarrier L g.coeff A).carrier := fun _ hx => ⟨hC hx.1, hx.2⟩
  have hAsub : (annihilatorZeroSubcarrier L g.coeff A).carrier ⊆ A.carrier :=
    fun _ hx => hx.1
  ext T
  constructor
  · intro hT
    have hT' : T ∈ V := hT
    rw [heq] at hT'
    have h := (mem_distributionalMeyerPairSpace_iff _ _ T).mp hT'
    exact (mem_distributionalMeyerPairSpace_iff _ _ T).mpr ⟨h.1.mono hCsub, h.2⟩
  · intro hT
    have h := (mem_distributionalMeyerPairSpace_iff _ _ T).mp hT
    exact (mem_distributionalMeyerPairSpace_iff _ _ T).mpr ⟨h.1.mono hAsub, h.2.mono hB'⟩

/-- On the exact real-rooted core, one literal numerator window and its
spectral and physical rows give the dimension of the complete original
pair space, for any cut. -/
theorem exists_common_realRooted_rationalRows_of_unitCellBound
    (A B : LocallyFiniteCarrier) (K : ℕ) (hK : UnitCellBound A K) (s : ℝ) :
    let Γ := pairSpectralModule A B
    let L := Γ.subtype
    ∃ (g : AddMonoidAlgebra ℂ Γ) (lo hi : Γ)
      (hlo : g.coeff lo ≠ 0) (hhi : g.coeff hi ≠ 0)
      (hmin : ∀ m ∈ g.coeff.support, m ≠ lo → L lo < L m)
      (hmax : ∀ m ∈ g.coeff.support, m ≠ hi → L m < L hi),
      let A₀ := annihilatorZeroSubcarrier L g.coeff A
      let B₀ := pairSpectralCore A B
      let W := literalNumeratorWindow L g.coeff lo hi B₀ s
      let rows := literalRationalRows L g lo hi hlo hhi hmin hmax A₀ B₀ s
      (∀ z : ℂ, z.im ≠ 0 → complexExponentialSum L g.coeff z ≠ 0) ∧
      DistributionalMeyerPairSpace A B = DistributionalMeyerPairSpace A₀ B₀ ∧
      (∃ e : DistributionalMeyerPairSpace A B ≃ₗ[ℂ] LinearMap.ker rows,
        ∀ T n, (e T).val.val.coeff n =
          cutArrayNumerator L g.coeff s (originalFourierArray L B₀ T) n) ∧
      Module.finrank ℂ (DistributionalMeyerPairSpace A B) +
        Module.finrank ℂ (LinearMap.range rows) = W.ncard := by
  classical
  let Γ := pairSpectralModule A B
  let L := Γ.subtype
  have hL : Function.Injective L := Subtype.val_injective
  obtain ⟨hΓ, _, _, g, _, _, hg, _, hroot, heq⟩ :=
    exists_common_realRooted_core_of_unitCellBound A B K hK
  let _ : Module.Finite ℤ Γ := Module.Finite.iff_addGroup_fg.mpr
    ((AddGroup.fg_iff_addSubgroup_fg Γ).mpr hΓ)
  have hg' : g.coeff ≠ 0 := fun h => hg
    (AddMonoidAlgebra.coeff_injective (h.trans AddMonoidAlgebra.coeff_zero.symm))
  obtain ⟨lo, hi, hlo, hhi, _, hmin, hmax⟩ := finiteAnnihilator_extrema L hL g.coeff hg'
  let A₀ := annihilatorZeroSubcarrier L g.coeff A
  let B₀ := pairSpectralCore A B
  have hA₀ : ∀ x ∈ A₀.carrier, annihilatorExponentialSymbol L g.coeff x = 0 :=
    fun _ hx => hx.2
  obtain ⟨⟨e, he⟩, hdim⟩ := originalPair_finrank_add_literalRationalRows_rank
    L hL g lo hi hlo hhi hmin hmax hroot A₀ B₀ (pairSpectralCore_range A B) hA₀ s
  refine ⟨g, lo, hi, hlo, hhi, hmin, hmax, hroot, heq, ?_, ?_⟩
  · let i := LinearEquiv.ofEq _ _ heq
    exact ⟨i.trans e, fun T n => he (i T) n⟩
  · rw [heq]
    exact hdim

end

end MeyerGeneralProblem
